# Server-only migration credential from your own Neon Free project.
DATABASE_URL=
# Written by pnpm db:migrate; application role must never bypass RLS.
APP_DATABASE_URL=
# Generate a random secret of at least 32 bytes. Keep it for TOTP recovery/restore.
BETTER_AUTH_SECRET=
# Production: https://winzerapp.vercel.app ; local: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# Stable 32-byte base64url key for tenant integration credentials. Back up securely.
INTEGRATION_ENCRYPTION_KEY=
# Random bearer secret for the daily Vercel worker.
CRON_SECRET=
# Comma-separated HTTPS hosts approved for customer API contracts; no hosts by default.
ERP_ALLOWED_HOSTS=
# Optional SMTP provider, not provisioned automatically.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
